MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1686462810}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bf035807a7a55240a5193535a38d554, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 404311552}
  lines:
  - Hey man, where are you getting off?
  - Y'know, I'm not getting off at all.
  - I'm gonna take this train to the end and take the next one
  - Someday a good idea's gonna come to me
  - It didn't come yesterday
  - Hasn't come today
  - I don't really care.
  - It's nice being alive.
  - 'Work is only good work if it ain''t work. '
  - Am I alive?
  - Are you going to work?
  - Why should you? For money?
  - 'I''m waiting for that good idea. '
  - Maybe it'll come tomorrow.
  - Then I'll get off the train...
